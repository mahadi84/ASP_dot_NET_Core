07. Delete everything and paste this in: Program.cs

using BankServerCrud.Data;
using Microsoft.EntityFrameworkCore;

Console.WriteLine("====================================");
Console.WriteLine("   Show Data from MySQL Table");
Console.WriteLine("====================================");

try
{
    using var db = new AppDbContext();

    Console.WriteLine("Trying to connect to MySQL...");

    bool isConnected = db.Database.CanConnect();

    if (!isConnected)
    {
        Console.WriteLine("Database connection failed.");
        return;
    }

    Console.WriteLine("Database connected successfully.");
    Console.WriteLine();

    var connection = db.Database.GetDbConnection();

    connection.Open();

    using var command = connection.CreateCommand();

    command.CommandText = @"
        SELECT server_id, server_name, purpose
        FROM bank_servers
        ORDER BY server_id;
    ";

    using var reader = command.ExecuteReader();

    Console.WriteLine("{0,-10} {1,-25} {2,-40}", "ID", "Server Name", "Purpose");
    Console.WriteLine(new string('-', 80));

    bool hasData = false;

    while (reader.Read())
    {
        hasData = true;

        int serverId = reader.GetInt32(0);
        string serverName = reader.GetString(1);
        string purpose = reader.GetString(2);

        Console.WriteLine(
            "{0,-10} {1,-25} {2,-40}",
            serverId,
            serverName,
            purpose
        );
    }

    if (!hasData)
    {
        Console.WriteLine("No data found in bank_servers table.");
    }

    connection.Close();
}
catch (Exception ex)
{
    Console.WriteLine("Error occurred.");
    Console.WriteLine("------------------------------------");
    Console.WriteLine($"Error Message: {ex.Message}");
    Console.WriteLine("------------------------------------");
}






=========================== In Real Apps DB Connection is like this ============================

appsettings.json = stores the connection string
Program.cs = reads the connection string and registers the DbContext
AppDbContext = represents the database connection layer
Controller = uses DbContext to get/save data
View = shows data to the user
MySQL = stores real data



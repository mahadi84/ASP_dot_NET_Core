using BankServerCrud.Data;
using Microsoft.EntityFrameworkCore;

Console.WriteLine("====================================");
Console.WriteLine("   Show Data from MySQL Table");
Console.WriteLine("====================================");

try
{
    using var db = new AppDbContext();

    Console.WriteLine("Trying to connect to MySQL...");

    bool isConnected = db.Database.CanConnect();

    if (!isConnected)
    {
        Console.WriteLine("Database connection failed.");
        return;
    }

    Console.WriteLine("Database connected successfully.");
    Console.WriteLine();

    var connection = db.Database.GetDbConnection();

    connection.Open();

    using var command = connection.CreateCommand();

    command.CommandText = @"
        SELECT server_id, server_name, purpose
        FROM bank_servers
        ORDER BY server_id;
    ";

    using var reader = command.ExecuteReader();

    Console.WriteLine("{0,-10} {1,-25} {2,-40}", "ID", "Server Name", "Purpose");
    Console.WriteLine(new string('-', 80));

    bool hasData = false;

    while (reader.Read())
    {
        hasData = true;

        int serverId = reader.GetInt32(0);
        string serverName = reader.GetString(1);
        string purpose = reader.GetString(2);

        Console.WriteLine(
            "{0,-10} {1,-25} {2,-40}",
            serverId,
            serverName,
            purpose
        );
    }

    if (!hasData)
    {
        Console.WriteLine("No data found in bank_servers table.");
    }

    connection.Close();
}
catch (Exception ex)
{
    Console.WriteLine("Error occurred.");
    Console.WriteLine("------------------------------------");
    Console.WriteLine($"Error Message: {ex.Message}");
    Console.WriteLine("------------------------------------");
}













=========================== In Real Apps DB Connection is like this ============================

------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
| Part             | Definition                                                                        | One-line example                                                                                                                          |
| ---------------- | --------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------- |
| appsettings.json | Stores application settings, including the database connection string.            | `"DefaultConnection": "Server=localhost;Database=Emp;User=root;Password=Mahadi@123;"`                                                     |
| Program.cs       | Reads the connection string and registers `AppDbContext` in dependency injection. | `builder.Services.AddDbContext<AppDbContext>(options => options.UseMySql(connectionString, ServerVersion.AutoDetect(connectionString)));` |
| AppDbContext     | Represents the database connection layer between the app and MySQL using EF Core. | `public DbSet<BankServer> BankServers { get; set; }`                                                                                      |
| Controller       | Handles user requests and uses `DbContext` to get, save, update, or delete data.  | `var servers = await _context.BankServers.ToListAsync();`                                                                                 |
| View             | Shows data to the user through Razor `.cshtml` pages.                             | `@foreach (var server in Model) { <td>@server.ServerName</td> }`                                                                                                              |
| MySQL            | Stores the real data inside tables.                                               | `SELECT * FROM bank_servers;`                                                                                                             |
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------


Flow:
appsettings.json → Program.cs → AppDbContext → Controller → View(Index.cshtml) → User
                                      ↓
                                    MySQL



